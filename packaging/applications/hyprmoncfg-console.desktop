[Desktop Entry]
Type=Application
Version=1.0
Name=Console Mode
GenericName=Steam Big Picture on the TV
Comment=Close the desktop and hand the machine to Steam's gamescope session
# In a terminal on purpose: entering closes the desktop session, and the
# countdown that says so -- and the Ctrl-C that stops it -- have to be visible.
Exec=hyprmoncfg console enter
Terminal=true
Categories=Game;Settings;
Keywords=Steam;Big Picture;gamescope;console;TV;couch;
Icon=input-gaming
StartupNotify=true
